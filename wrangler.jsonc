{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hxlfab",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "RFQ_DB",
      "database_name": "hxlfab-rfq",
      "database_id": "b91a74c3-071d-4251-8852-1534cb608dbe",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RFQ_FILES",
      "bucket_name": "hxlfab-rfq-files"
    }
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://hxlfab.com",
    "RFQ_FROM_EMAIL": "sales@hxlfab.com",
    "MAX_FILE_BYTES": "104857600",
    "MAX_TOTAL_BYTES": "209715200",
    "MAX_FILE_COUNT": "10"
  }
}
